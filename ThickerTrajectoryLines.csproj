<?xml version="1.0" encoding="UTF-8"?>
<!-- this is what's called an "sdk-style project" -->
<Project Sdk="Microsoft.NET.Sdk">
    <!-- Since KSP uses .NET 4.8 -->
    <PropertyGroup>
        <!-- THIS is where the .NET version you'll actually use gets specified. -->
        <TargetFramework>net4.8</TargetFramework>
        <LangVersion>9</LangVersion>
    </PropertyGroup>
    <!-- include KSPBuildTools - see below -->
    <ItemGroup>
        <PackageReference Include="KSPBuildTools" Version="1.1.1" />
    </ItemGroup>
    
    <!-- Version Files -->
    <ItemGroup>
        <KSPVersionFile Include=".">
            <Version>1.0.0</Version>
            <KSP_Version>1.12</KSP_Version>
            <KSP_VERSION_MIN>1.12</KSP_VERSION_MIN>
            <KSP_VERSION_MAX>1.12</KSP_VERSION_MAX>
            <Destination>$(KSPBT_ModRoot)/mod.version</Destination>
            <URL>https://github.com/murolem/ksp-mod-thicker-trajectory-lines/releases/latest/download/mod.version</URL>
            <Download>https://github.com/murolem/ksp-mod-thicker-trajectory-lines/releases/latest</Download>
        </KSPVersionFile>
    </ItemGroup>
    
    <ItemGroup>
        <ModReference Include="0Harmony">
            <DLLPath>GameData/000_Harmony/0Harmony.dll</DLLPath>
        </ModReference>
        <ModReference Include="ClickThroughBlocker">
            <DLLPath>GameData/000_ClickThroughBlocker/Plugins/ClickThroughBlocker.dll</DLLPath>
        </ModReference>
        <ModReference Include="ToolbarController">
            <DLLPath>GameData/001_ToolbarControl/Plugins/ToolbarControl.dll</DLLPath>
        </ModReference>
    </ItemGroup>
    
    <ItemGroup>
      <Folder Include="Static\" />
    </ItemGroup>
    
    <ItemGroup>
      <Reference Include="Assembly-CSharp">
        <HintPath>..\..\.var\app\com.valvesoftware.Steam\.local\share\Steam\steamapps\common\Kerbal Space Program\KSP_x64_Data\Managed\Assembly-CSharp.dll</HintPath>
      </Reference>
      <Reference Include="mscorlib">
        <HintPath>..\..\.var\app\com.valvesoftware.Steam\.local\share\Steam\steamapps\common\Kerbal Space Program\KSP_x64_Data\Managed\mscorlib.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine">
        <HintPath>..\..\.var\app\com.valvesoftware.Steam\.local\share\Steam\steamapps\common\Kerbal Space Program\KSP_x64_Data\Managed\UnityEngine.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.CoreModule">
        <HintPath>..\..\.var\app\com.valvesoftware.Steam\.local\share\Steam\steamapps\common\Kerbal Space Program\KSP_x64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      </Reference>
    </ItemGroup>

    <!-- include static assets -->
    <Target Name="OnBuild" BeforeTargets="Build">
        <ItemGroup>
            <StaticFiles Include="Static/**/*" />
        </ItemGroup>
        <Copy SourceFiles="@(StaticFiles)"
              DestinationFolder="$(KSPBT_ModRoot)/%(RecursiveDir)" />
    </Target>
</Project>